# Confluent Cloud Tableflow Configuration
# Copy this file to .env and update with your actual values

# Confluent API Credentials
# Get these from: Confluent Cloud Console → API Keys
CONFLUENT_API_KEY=your-api-key-here
CONFLUENT_API_SECRET=your-api-secret-here

# TableFlow REST Catalog URI
# Get this from: Confluent Cloud → TableFlow → Copy REST Catalog URI
TABLEFLOW_REST_CATALOG_URI=https://tableflow.your-region.aws.confluent.cloud/iceberg/catalog/organizations/your-org-id/environments/your-env-id

# Confluent Cloud Region
# This should match your Kafka cluster's region
CONFLUENT_REGION=your-region-here

# Example values (replace with your actual values):
# CONFLUENT_API_KEY=ABC123DEF456
# CONFLUENT_API_SECRET=xyz789uvw012
# TABLEFLOW_REST_CATALOG_URI=https://tableflow.us-west-2.aws.confluent.cloud/iceberg/catalog/organizations/12345/environments/env-abc123
# CONFLUENT_REGION=us-west-2
